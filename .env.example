# Environment Configuration — Ajaia Docs Collaborative Workspace
PORT=3000

# Optional Cloud Postgres Connection String (Neon / Supabase / Railway)
# If omitted, Ajaia Docs automatically persists to data/ajaia-store.json locally
DATABASE_URL=

# Optional LLM Provider Key for Live AI Document Copilot
# If omitted, the server automatically degrades to deterministic fallback mode
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
